@startuml diagrama-de-componentes
title Sistema de Moeda Estudantil - Diagrama de Componentes (MVC, Release 02)
skinparam componentStyle uml2
left to right direction

package "Front-end (React) - View" {
  [Paginas] as Paginas
  note right of Paginas
    Login, Cadastro de Aluno e de Empresa,
    Perfis, Meus Alunos,
    Enviar Moedas, Extrato, Vantagens
    (catalogo e resgate), Gestao de
    Vantagens, Cupons Resgatados
  end note
  [Componentes UI\n(Layout, RotaProtegida, ...)] as UI
  [AuthContext\n(sessao JWT)] as AuthCtx
  [Cliente HTTP (Axios)\nalunoApi, empresaApi,\nvantagemApi, transacaoApi] as Api
  Paginas --> UI
  Paginas --> AuthCtx
  Paginas --> Api
  AuthCtx --> Api
}

package "Back-end (Node.js + Express)" {
  interface "API REST (JSON)" as IRest
  [Routes] as Routes
  [Middlewares de Autenticacao\n(autenticar, autorizar, somenteProprio)\nJWT] as Auth

  package "Controller" {
    [AuthController]
    [AlunoController]
    [EmpresaParceiraController]
    [InstituicaoEnsinoController]
    [VantagemController]
    [TransacaoController]
  }

  package "Service (regras de negocio)" {
    [AuthService\n(bcrypt + JWT)] as AuthSvc
    [AlunoService]
    [EmpresaParceiraService]
    [VantagemService]
    [TransacaoService]
    [ResgateService]
    [CreditoSemestralService]
  }

  package "Model (persistencia)" {
    [DAOs\n(UsuarioDAO, AlunoDAO, ProfessorDAO,\nEmpresaParceiraDAO, VantagemDAO,\nInstituicaoEnsinoDAO, TransacaoDAO)] as DAO
    [Prisma Client (ORM)\nschema.prisma] as Prisma
    DAO --> Prisma
  }

  interface "IEmail" as IEmail
  [EmailService\n(Nodemailer)] as EmailSvc
  [Upload de Fotos\n(Multer)] as Upload
  [Agendador\n(node-cron)] as Cron

  IRest - Routes
  Routes --> Auth
  Routes --> Upload
  Auth --> Controller
  Auth ..> AuthSvc : valida token
  Controller --> "Service (regras de negocio)"
  "Service (regras de negocio)" --> DAO
  EmailSvc - IEmail
  [TransacaoService] --( IEmail
  [ResgateService] --( IEmail
  Cron --> [CreditoSemestralService]
}

database "PostgreSQL" as DB
node "Servidor SMTP" as SMTP
folder "Armazenamento\nde Imagens\n(uploads/)" as Storage

Api --( IRest : HTTP/JSON\nBearer token
Prisma --> DB : SQL
EmailSvc --> SMTP : SMTP
Upload --> Storage
@enduml
