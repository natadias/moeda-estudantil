@startuml sd07-cadastrar-vantagem
title SD07 - Empresa parceira cadastra vantagem com foto
autonumber
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true

actor "Empresa Parceira" as Empresa
participant "VantagemForm\n(React)" as UI
participant "Middlewares\nautenticar, autorizar('EMPRESA')" as MW
participant "Upload\n(Multer, em memória)" as Up
participant "VantagemController" as C
participant "VantagemService" as S
participant "VantagemDAO" as DAO
database "PostgreSQL" as DB
actor Aluno

Empresa -> UI : nome, descrição, custo em moedas e foto
UI -> MW : POST /api/vantagens (multipart/form-data)
MW -> Up : receberFoto
alt arquivo não é imagem ou passa de 2 MB
  Up --> UI : 422
else imagem válida
  Up -> C : cadastrar(req, res)\nreq.body.foto = {dados, tipo}
  C -> S : cadastrar(empresaId, dados)
  S -> S : valida nome, descrição, custo inteiro > 0 e foto
  alt dados inválidos
    S --> C : AppError 422
    C --> UI : 422
  else dados válidos
    S -> DAO : create({..., foto, fotoTipo, empresaId, ativa: true})
    DAO -> DB : INSERT vantagem (foto em BYTEA)
    DB --> DAO : vantagem (sem os bytes da foto)
    DAO --> S : vantagem
    S --> C : vantagem com fotoUrl = /api/vantagens/{id}/foto?v={versão}
    C --> UI : 201 Created
    UI --> Empresa : vantagem aparece em "Minhas vantagens"
  end
end

== Exibição da foto no catálogo ==
Aluno -> UI : abre "Vantagens"
UI -> C : GET /api/vantagens/{id}/foto?v={versão}
C -> S : buscarFoto(id)
S -> DAO : findFoto(id)
DAO -> DB : SELECT foto, foto_tipo
DB --> DAO : bytes
DAO --> S : foto
S --> C : {dados, tipo}
C --> UI : 200 image/jpeg\nCache-Control: immutable
@enduml
